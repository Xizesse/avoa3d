        </model>

        <!-- !OBSTACULO 6 (Green - Moving Rectangle) -->
        <model name='obstacle_6' canonical_link='obstacle'>
            <static>false</static>
            <pose relative_to='world'>15.0 -40.0 0.1 0 0 0</pose> <!-- z=0.1 for 0.2m height -->
