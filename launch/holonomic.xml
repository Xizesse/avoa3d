<?xml version="1.0"?>
<launch>
    <!-- Declare launch arguments -->
    <arg name="name" default="ros_gz_bridge"/>
    <arg name="config_file" default="config/bridge_config.yaml"/>
    <arg name="namespace" default=""/>
    <arg name="log_level" default="info"/>
    <arg name="scenario" default="1" description="Scenario number: s=static, d=dynamic."/>

    <!-- Define SDF file based on scenario -->
    <let name="sdf_file" value="$(env HOME)/ros_ws/src/avoa3d/sdf/single_static1.sdf"   if="$(eval '&quot;$(var scenario)&quot; == &quot;s0&quot;')"/>
    <let name="sdf_file" value="$(env HOME)/ros_ws/src/avoa3d/sdf/single_static2.sdf"   if="$(eval '&quot;$(var scenario)&quot; == &quot;s1&quot;')"/>
    <let name="sdf_file" value="$(env HOME)/ros_ws/src/avoa3d/sdf/single_static3.sdf"   if="$(eval '&quot;$(var scenario)&quot; == &quot;s2&quot;')"/>
    <let name="sdf_file" value="$(env HOME)/ros_ws/src/avoa3d/sdf/single_dynamic1.sdf" if="$(eval '&quot;$(var scenario)&quot; == &quot;d0&quot;')"/>
    <let name="sdf_file" value="$(env HOME)/ros_ws/src/avoa3d/sdf/single_dynamic2.sdf" if="$(eval '&quot;$(var scenario)&quot; == &quot;d1&quot;')"/>
    <let name="sdf_file" value="$(env HOME)/ros_ws/src/avoa3d/sdf/single_dynamic3.sdf" if="$(eval '&quot;$(var scenario)&quot; == &quot;d2&quot;')"/>
    <let name="sdf_file" value="$(env HOME)/ros_ws/src/avoa3d/sdf/single_dynamic4.sdf" if="$(eval '&quot;$(var scenario)&quot; == &quot;d3&quot;')"/>
    <let name="sdf_file" value="$(env HOME)/ros_ws/src/avoa3d/sdf/single_dynamic5.sdf" if="$(eval '&quot;$(var scenario)&quot; == &quot;d4&quot;')"/>

    <!-- Launch Gazebo simulation -->
    <executable cmd="gz sim 4 -r $(var sdf_file)" output="screen"/>

    <!-- Launch the ros_gz_bridge node -->
    <node
        pkg="ros_gz_bridge"
        exec="parameter_bridge"
        name="$(var name)"
        namespace="$(var namespace)"
        output="screen"
        args="--ros-args --log-level $(var log_level)">
        <param name="use_sim_time" value="true"/>
        <param name="config_file" value="$(env HOME)/ros_ws/src/avoa3d/config/bridge_config.yaml"/>
    </node>

    <!-- Launch avoa3d nodes -->
    <node
        pkg="avoa3d"
        exec="obstacle_publisher"
        name="obstacle_publisher"
        output="screen">
        <param name="use_sim_time" value="true"/>
    </node>

    <node
        pkg="avoa3d"
        exec="rviz_marker"
        name="rviz_marker"
        output="screen">
        <param name="use_sim_time" value="true"/>
    </node>

    <node
        pkg="avoa3d"
        exec="test_w_goal"
        name="test_w_goal"
        output="screen">
        <param name="use_sim_time" value="true"/>
    </node>

    <!-- Launch AVOA node with holonomic parameters -->
    <node pkg="avoa3d" exec="avoa3dnode" name="avoa3dnode" output="screen">
        <param name="use_sim_time" value="true"/>
        <param from="$(find-pkg-share avoa3d)/config/holonomic_params.yaml"/>
    </node>
    
</launch>