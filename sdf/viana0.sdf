        <!-- !OBSTACULO 9 (Static Cylinder) -->
        <model name='obstacle_9' canonical_link='obstacle'>
            <static>true</static>
            <pose relative_to='world'>20.0 -20.0 0 0 0 0</pose> <!-- x=-y, z=1.5 for 3m height -->
            <link name='obstacle'>
                <pose relative_to='__model__'>0.0 0 0.0 0 0 0</pose>
                <inertial>
                    <mass>15.0</mass>
