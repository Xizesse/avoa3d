            </plugin> 
            
            <plugin
                filename="ignition-gazebo-odometry-publisher-system"
                name="ignition::gazebo::systems::OdometryPublisher">
                <dimensions>3</dimensions>
            </plugin>
        </model>

        <!-- !OBSTACULO 7 (Static Cylinder) -->
        <model name='obstacle_7' canonical_link='obstacle'>
            <static>true</static>
            <pose relative_to='world'>10.0 -13.0 0 0 0 0</pose> <!-- x=-y, z=1.5 for 3m height -->
            <link name='obstacle'>
                <pose relative_to='__model__'>0.0 0 0.0 0 0 0</pose>
                <inertial>
                    <mass>15.0</mass>
                    <inertia>
                        <ixx>11.44</ixx>   <!-- (1/12)*15*(3*0.5²+3²) = 11.44 -->
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>11.44</iyy>   <!-- Same as ixx for cylinder -->
                        <iyz>0</iyz>
                        <izz>1.875</izz>   <!-- (1/2)*15*0.5² = 1.875 -->
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <cylinder>
                            <radius>0.5</radius> <!-- 1m diameter = 0.5m radius -->
                            <length>1.0</length> <!-- height -->
                        </cylinder>
                    </geometry>
                    <material>
                        <ambient>0.7 0.7 0.7 1</ambient> <!-- Gray -->
                        <diffuse>0.7 0.7 0.7 1</diffuse>
                        <specular>0.7 0.7 0.7 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <cylinder>
                            <radius>0.5</radius>
                            <length>1.0</length>
                        </cylinder>
                    </geometry>
                </collision>
                <enable_gravity>false</enable_gravity>
            </link>
        </model>

