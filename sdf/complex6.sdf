        <!-- !OBSTACULO 6 (Right side of V) -->
        <model name='obstacle_6' canonical_link='obstacle'>
            <static>true</static>
            <pose relative_to='world'>1.0 2.0 0.5 0 0 0</pose>
            <link name='obstacle'>
                <pose relative_to='__model__'>0.0 0 0.0 0 0 0</pose>
                <visual name='visual'>
                    <geometry>
                        <sphere>
                            <radius>0.5</radius> 
