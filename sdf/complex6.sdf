        <!-- !OBSTACULO 5 (Right side of V) -->
        <model name='obstacle_5' canonical_link='obstacle'>
            <static>true</static>
            <pose relative_to='world'>2.0 1.0 0.5 0 0 0</pose>
            <link name='obstacle'>
                <pose relative_to='__model__'>0.0 0 0.0 0 0 0</pose>
