                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <cylinder>
                            <radius>0.5</radius> <!-- 1m diameter = 0.5m radius -->
                            <length>1.0</length> <!-- height -->
                        </cylinder>
                    </geometry>
                    <material>
                        <ambient>0.5 0.5 0.5 1</ambient> <!-- Dark Gray -->
                        <diffuse>0.5 0.5 0.5 1</diffuse>
                        <specular>0.5 0.5 0.5 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <cylinder>
                            <radius>0.5</radius>
                            <length>3.0</length>
                        </cylinder>
                    </geometry>
                </collision>
                <enable_gravity>false</enable_gravity>
            </link>
        </model>

        

       
    </world>
</sdf>