<?xml version="1.0" ?>
<sdf version="1.8">
    <world name="3d_world">
        <physics name="1ms" type="ode">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
            <real_time_update_rate>1000.0</real_time_update_rate>
        </physics>
        <gravity>0 0 0</gravity> <!-- World-level gravity disabled -->

        <plugin
            filename="gz-sim-physics-system"
            name="gz::sim::v8::systems::Physics">
        </plugin>
        <plugin
            filename="libignition-gazebo-user-commands-system.so"
            name="ignition::gazebo::systems::UserCommands">
        </plugin>
        <plugin
            filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
        </plugin>
        <!-- Add the Sensors system plugin -->
        <plugin
            filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

    

        <light type="directional" name="sun"> 
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <!--!AGENTE -->
        <model name='agente' canonical_link='chassis'>
            <pose relative_to='world'>0.0 0 0.0 0 0 0</pose> <!-- Starting at origin -->
            <link name='chassis'>
                <pose relative_to='__model__'>0.0 0 0.0 0 0 0</pose> <!-- Match the dynamic file positioning -->
                <inertial>
                    <mass>1.14395</mass>
                    <inertia>
                        <ixx>0.095329</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>0.381317</iyy>
                        <iyz>0</iyz>
                        <izz>0.476646</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <box>
                            <size>1.0 1.0 1.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.0 0.0 1.0 1</ambient>
                        <diffuse>0.0 0.0 1.0 1</diffuse>
                        <specular>0.0 0.0 1.0 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <box>
                            <size>1.0 1.0 1.0</size>
                        </box>
                    </geometry>
                </collision>
                <enable_gravity>false</enable_gravity>
            </link>
            
            <!-- LiDAR link -->
            <link name='lidar_link'>
                <pose relative_to='chassis'>0.0 0 0.5 0 0 0</pose>
                <inertial>
                    <mass>0.1</mass>
                    <inertia>
                        <ixx>0.000166667</ixx>
                        <iyy>0.000166667</iyy>
                        <izz>0.000166667</izz>
                    </inertia>
                </inertial>
                <collision name='collision'>
                    <geometry>
                        <cylinder>
                            <radius>0.05</radius>
                            <length>0.1</length>
                        </cylinder>
                    </geometry>
                </collision>
                <visual name='visual'>
                    <geometry>
                        <cylinder>
                            <radius>0.05</radius>
                            <length>0.1</length>
                        </cylinder>
                    </geometry>
                    <material>
                        <ambient>0.0 1.0 0.0 1</ambient>
                        <diffuse>0.0 1.0 0.0 1</diffuse>
                        <specular>0.0 1.0 0.0 1</specular>
                    </material>
                </visual>
                <sensor name="lidar" type="gpu_lidar">
                    <topic>scan</topic>
                    <update_rate>10</update_rate>
                    <lidar>
                        <scan>
                            <horizontal>
                                <samples>5000</samples>
                                <resolution>1</resolution>
                                <min_angle>-3.14159</min_angle>
                                <max_angle>3.14159</max_angle>
                            </horizontal>
                        </scan>
                        <range>
                            <min>0.1</min>
                            <max>50.0</max>
                            <resolution>0.01</resolution>
                        </range>
                    </lidar>
                    <visualize>true</visualize>
                    <always_on>true</always_on>
                    <update_rate>10</update_rate>
                    <pose_frame>lidar</pose_frame>

                
                </sensor>
                <enable_gravity>false</enable_gravity>
            </link>

            <!-- Joint to connect LiDAR to chassis -->
            <joint name="lidar_joint" type="fixed">
                <parent>chassis</parent>
                <child>lidar_link</child>
            </joint>
            
            <!-- plugin to publish-->
            <plugin
                filename="ignition-gazebo-joint-state-publisher-system"
                name="ignition::gazebo::systems::JointStatePublisher">
            </plugin>

            <plugin
                filename="ignition-gazebo-odometry-publisher-system"
                name="ignition::gazebo::systems::OdometryPublisher">
                <dimensions>3</dimensions>
            </plugin>
            
            <plugin
                filename="ignition-gazebo-velocity-control-system"
                name="ignition::gazebo::systems::VelocityControl">
                <initial_linear>0.0 0 0</initial_linear>
                <initial_angular>0 0 0.0</initial_angular>
            </plugin> 
            
            <plugin
                filename="libignition-gazebo-pose-publisher-system.so"
                name="ignition::gazebo::systems::PosePublisher">
                <topic>/agente/pose</topic>
                <frame_id>agente</frame_id>
                <update_rate>30</update_rate>
            </plugin>
        </model>

        <!-- !OBSTACULO 1 (Rectangle: 23m x 1m x 0.5m, centered at x=0, y=-30) -->
        <model name='obstacle_1' canonical_link='obstacle'>
            <static>false</static>
            <pose relative_to='world'>0.0 -30.0 0.25 0 0 0</pose> <!-- z=0.25 so bottom is at z=0, top at z=0.5 -->
            <link name='obstacle'>
                <pose relative_to='__model__'>0.0 0 0.0 0 0 0</pose>
                <inertial>
                    <mass>100.0</mass>
                    <inertia>
                        <ixx>10.42</ixx>    <!-- (1/12)*100*(1²+0.5²) = 10.42 -->
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>4410.42</iyy>  <!-- (1/12)*100*(23²+0.5²) = 4410.42 -->
                        <iyz>0</iyz>
                        <izz>4416.67</izz>  <!-- (1/12)*100*(23²+1²) = 4416.67 -->
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <box>
                            <size>23.0 1.0 0.5</size> <!-- length x width x height -->
                        </box>
                    </geometry>
                    <material>
                        <ambient>1.0 0.0 0.0 1</ambient>
                        <diffuse>1.0 0.0 0.0 1</diffuse>
                        <specular>1.0 0.0 0.0 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <box>
                            <size>23.0 1.0 0.5</size>
                        </box>
                    </geometry>
                </collision>
                <enable_gravity>false</enable_gravity>
            </link>
            
            <plugin
                filename="ignition-gazebo-velocity-control-system"
                name="ignition::gazebo::systems::VelocityControl">
                <initial_linear>0.0 0 0</initial_linear>
                <initial_angular>0 0 0.0</initial_angular>
            </plugin> 
            
            <plugin
                filename="ignition-gazebo-odometry-publisher-system"
                name="ignition::gazebo::systems::OdometryPublisher">
                <dimensions>3</dimensions>
            </plugin>
        </model>

        <!-- !OBSTACULO 2 (Cylinder: radius 6m, height 10m, centered at x=26, y=0) -->
        <model name='obstacle_2' canonical_link='obstacle'>
            <static>false</static>
            <pose relative_to='world'>26.0 0.0 5.0 0 0 0</pose> <!-- z=5.0 so bottom is at z=0, top at z=10 -->
            <link name='obstacle'>
                <pose relative_to='__model__'>0.0 0 0.0 0 0 0</pose>
                <inertial>
                    <mass>200.0</mass>
                    <inertia>
                        <ixx>3466.67</ixx>  <!-- (1/12)*200*(3*6²+10²) = 3466.67 -->
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>3466.67</iyy>  <!-- Same as ixx for cylinder -->
                        <iyz>0</iyz>
                        <izz>3600.0</izz>   <!-- (1/2)*200*6² = 3600 -->
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <cylinder>
                            <radius>6.0</radius>
                            <length>10.0</length> <!-- height -->
                        </cylinder>
                    </geometry>
                    <material>
                        <ambient>1.0 0.0 0.0 1</ambient>
                        <diffuse>1.0 0.0 0.0 1</diffuse>
                        <specular>1.0 0.0 0.0 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <cylinder>
                            <radius>6.0</radius>
                            <length>10.0</length>
                        </cylinder>
                    </geometry>
                </collision>
                <enable_gravity>false</enable_gravity>
            </link>
            
            <plugin
                filename="ignition-gazebo-velocity-control-system"
                name="ignition::gazebo::systems::VelocityControl">
                <initial_linear>0.0 0 0</initial_linear>
                <initial_angular>0 0 0.5</initial_angular>
            </plugin> 
            
            <plugin
                filename="ignition-gazebo-odometry-publisher-system"
                name="ignition::gazebo::systems::OdometryPublisher">
                <dimensions>3</dimensions>
            </plugin>
        </model>

        <!-- !OBSTACULO 3 (Orange - Moving Rectangle) -->
        <model name='obstacle_3' canonical_link='obstacle'>
            <static>false</static>
            <pose relative_to='world'>30.0 -10.0 1.5 0 0 0</pose> <!-- z=1.5 for 3m height -->
            <link name='obstacle'>
                <pose relative_to='__model__'>0.0 0 0.0 0 0 0</pose>
                <inertial>
                    <mass>20.0</mass>
                    <inertia>
                        <ixx>15.01</ixx>   <!-- (1/12)*20*(0.2²+3²) = 15.01 -->
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>60.67</iyy>   <!-- (1/12)*20*(6²+3²) = 60.67 -->
                        <iyz>0</iyz>
                        <izz>60.07</izz>   <!-- (1/12)*20*(6²+0.2²) = 60.07 -->
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <box>
                            <size>6.0 2 3.0</size> <!-- length x width x height -->
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.8 0.4 0.0 1</ambient> <!-- Orange -->
                        <diffuse>0.8 0.4 0.0 1</diffuse>
                        <specular>0.8 0.4 0.0 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <box>
                            <size>6.0 2 3.0</size>
                        </box>
                    </geometry>
                </collision>
                <enable_gravity>false</enable_gravity>
            </link>
            
            <plugin
                filename="ignition-gazebo-velocity-control-system"
                name="ignition::gazebo::systems::VelocityControl">
                <initial_linear>-1.0 0.0 0</initial_linear> <!-- Negative X movement -->
                <initial_angular>0 0 0.0</initial_angular>
            </plugin> 
            
            <plugin
                filename="ignition-gazebo-odometry-publisher-system"
                name="ignition::gazebo::systems::OdometryPublisher">
                <dimensions>3</dimensions>
            </plugin>
        </model>

        <!-- !OBSTACULO 4 (Purple - Moving Rectangle) -->
        <model name='obstacle_4' canonical_link='obstacle'>
            <static>false</static>
            <pose relative_to='world'>15.0 -50.0 0.1 0 0 0</pose> <!-- z=0.1 for 0.2m height -->
            <link name='obstacle'>
                <pose relative_to='__model__'>0.0 0 0.0 0 0 0</pose>
                <inertial>
                    <mass>10.0</mass>
                    <inertia>
                        <ixx>0.87</ixx>    <!-- (1/12)*10*(1²+0.2²) = 0.87 -->
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>3.37</iyy>    <!-- (1/12)*10*(2²+0.2²) = 3.37 -->
                        <iyz>0</iyz>
                        <izz>4.17</izz>    <!-- (1/12)*10*(2²+1²) = 4.17 -->
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <box>
                            <size>2.0 1.0 1.0</size> <!-- length x width x height -->
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.5 0.0 0.8 1</ambient> <!-- Purple -->
                        <diffuse>0.5 0.0 0.8 1</diffuse>
                        <specular>0.5 0.0 0.8 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <box>
                            <size>2.0 1.0 1.0</size>
                        </box>
                    </geometry>
                </collision>
                <enable_gravity>false</enable_gravity>
            </link>
            
            <plugin
                filename="ignition-gazebo-velocity-control-system"
                name="ignition::gazebo::systems::VelocityControl">
                <initial_linear>0.0 1.0 0</initial_linear> <!-- Positive Y movement -->
                <initial_angular>0 0 0.0</initial_angular>
            </plugin> 
            
            <plugin
                filename="ignition-gazebo-odometry-publisher-system"
                name="ignition::gazebo::systems::OdometryPublisher">
                <dimensions>3</dimensions>
            </plugin>
        </model>

        <!-- !OBSTACULO 5 (Cyan - Moving Rectangle) -->
        <model name='obstacle_5' canonical_link='obstacle'>
            <static>false</static>
            <pose relative_to='world'>15.0 -35.0 0.1 0 0 0</pose> <!-- z=0.1 for 0.2m height -->
