                        <ambient>0.0 0.8 0.8 1</ambient> <!-- Cyan -->
                        <diffuse>0.0 0.8 0.8 1</diffuse>
                        <specular>0.0 0.8 0.8 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <box>
                            <size>2.0 1.0 0.2</size>
                        </box>
                    </geometry>
                </collision>
                <enable_gravity>false</enable_gravity>
