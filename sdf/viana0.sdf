                        <ixx>0.87</ixx>    <!-- (1/12)*10*(1²+0.2²) = 0.87 -->
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>3.37</iyy>    <!-- (1/12)*10*(2²+0.2²) = 3.37 -->
                        <iyz>0</iyz>
                        <izz>4.17</izz>    <!-- (1/12)*10*(2²+1²) = 4.17 -->
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <box>
                            <size>2.0 1.0 1.2</size> <!-- length x width x height -->
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.0 1.0 0.0 1</ambient> <!-- Green -->
                        <diffuse>0.0 1.0 0.0 1</diffuse>
                        <specular>0.0 1.0 0.0 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <box>
                            <size>2.0 1.0 0.2</size>
                        </box>
                    </geometry>
